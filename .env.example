# Copy to .env for local development (read by dotenvy). All settings: crates/api/src/config.rs
BIND_ADDR=127.0.0.1:3000
DATABASE_URL=sqlite://nullbox.db
# Build against the .sqlx cache: with DATABASE_URL alone, compiling fails until nullbox.db exists.
SQLX_OFFLINE=true
# Comma-separated. The web app runs on a different origin, like a Tauri webview would.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Where the web app lives; secret access links point here.
PUBLIC_WEB_URL=http://localhost:5173
# Unlocks GET /api/admin/export (header X-Admin-Token). Set a long random value of your own.
# ADMIN_TOKEN=
RUST_LOG=info,tower_http=debug

# OpenTelemetry export to Elastic. Off unless OTEL_EXPORTER_OTLP_ENDPOINT is set; the exporters read
# these standard variables themselves. Copy the endpoint from Elastic Cloud (Managed OTLP endpoint).
# Create the API key in Kibana (Add data > OpenTelemetry, or Stack Management > API keys).
# Keep the real values in .env or your secret store, never in this file. Percent-encode the space.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://<motlp-endpoint>
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey%20<api-key>
# OTEL_SERVICE_NAME=nullbox-api
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev
